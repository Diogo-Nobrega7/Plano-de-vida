# Exemplo dos segredos da versão online.
# NÃO coloque o arquivo real (secrets.toml) no GitHub: cole o conteúdo em
# Streamlit Cloud → seu app → Settings → Secrets.

# Supabase → Connect → "Session pooler" (troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha para entrar no app
APP_PASSWORD = "uma-senha-forte-aqui"
